# Commerce data: fixtures (no credentials, bracketed placeholder prices) or shopify.
COMMERCE_SOURCE=fixtures

# Shopify Storefront API (server-only; never prefix these with NEXT_PUBLIC_).
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# Defaults to the pinned version in src/lib/config/env.ts.
SHOPIFY_API_VERSION=
# Webhook signing secret for /api/revalidate (Settings → Notifications → Webhooks).
SHOPIFY_REVALIDATION_SECRET=

# Fallback free-shipping threshold when the site_settings metaobject has none.
FREE_SHIPPING_THRESHOLD_AUD=80

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# live | waitlist
NEXT_PUBLIC_SITE_MODE=live

# Feature flags (on | off).
# Promotion pop-up at 10% of the home page. Off by default: the brief rules out pop-ups.
PROMO_POPUP=off
# The pixel familiar.
PIXEL_CAT=on
# Shopify's Shop Pay component in the PDP / cart slot (until wired, a labelled slot is shown).
SHOP_PAY=off
# Show bracketed prices even with live Shopify data (before real prices are set).
PRICE_PLACEHOLDERS=off

# Google/Facebook reviews: none (default, zero state) | sample (demo only, tagged SAMPLE DATA).
REVIEWS_SOURCE=none

# Provider keys (pending decisions; stubs log in dev and return 503 in production until set).
# KLAVIYO_API_KEY=
# BACK_IN_STOCK_API_KEY=
# RESEND_API_KEY=
