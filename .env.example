# Copy to .env.local. Every variable is optional in fixtures mode.

# fixtures (default, no Shopify needed) | shopify
COMMERCE_SOURCE=fixtures

# --- Shopify (required when COMMERCE_SOURCE=shopify) ---
# Bare domain, no protocol.
SHOPIFY_STORE_DOMAIN=witcha-matcha.myshopify.com
# Server-only private Storefront token (Headless channel). Never prefix with NEXT_PUBLIC_.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
# Public token, reserved for the Shop Pay component when it is enabled.
SHOPIFY_STOREFRONT_PUBLIC_TOKEN=
# Pinned Storefront API version; defaults to the version in src/lib/config/env.ts.
SHOPIFY_API_VERSION=2026-10
# Webhook signing secret used to verify X-Shopify-Hmac-Sha256 on /api/revalidate.
SHOPIFY_REVALIDATION_SECRET=

# --- Store settings ---
# Overrides the site_settings metaobject. Leave empty to use it (or the placeholder fallback).
FREE_SHIPPING_THRESHOLD_AUD=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# live | waitlist (waitlist enables /coming-soon)
NEXT_PUBLIC_SITE_MODE=live
# Shows the Shop Pay slot on PDP and cart once wired (see DEVIATIONS D-11).
NEXT_PUBLIC_FEATURE_SHOP_PAY=false

# --- Providers (decisions pending; dev stubs log to the console) ---
# stub | klaviyo | shopify
NEWSLETTER_PROVIDER=
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LIST_ID=
# stub | klaviyo
BACK_IN_STOCK_PROVIDER=
# stub | resend
CONTACT_PROVIDER=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# none (zero-state) until a reviews app is chosen
REVIEWS_PROVIDER=
